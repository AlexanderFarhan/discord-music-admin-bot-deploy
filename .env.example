# Wajib: ambil dari Discord Developer Portal
DISCORD_TOKEN=masukkan_token_bot
CLIENT_ID=masukkan_application_id

# Disarankan saat pengembangan agar slash command langsung muncul.
# Kosongkan untuk mendaftarkan command secara global.
GUILD_ID=masukkan_server_id

# Opsional: kanal tujuan catatan tindakan moderasi.
MOD_LOG_CHANNEL_ID=

# 1-100
DEFAULT_VOLUME=50

# info | debug | warn | error
LOG_LEVEL=info

